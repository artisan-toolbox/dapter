{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "artisan-toolbox/dapter",
    "description": "Data adapter foundations for Laravel and Inertia applications.",
    "keywords": [
        "laravel",
        "artisan-toolbox",
        "dapter",
        "inertia",
        "pagination",
        "filtering"
    ],
    "homepage": "https://github.com/artisan-toolbox/dapter",
    "license": "MIT",
    "authors": [
        {
            "name": "Allan Mariucci Carvalho",
            "email": "contact@atb.dev.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "artisan-toolbox/maintainer": "^1.10.0",
        "illuminate/support": "^13.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.3",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.8.4"
    },
    "autoload": {
        "psr-4": {
            "ArtisanToolbox\\Dapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArtisanToolbox\\Dapter\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "@php vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "test:types": [
            "@php vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "@php vendor/bin/pest"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "quality:check": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/maintainer quality:check --no-interaction"
        ],
        "quality:fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/maintainer quality:fix --no-interaction"
        ],
        "distribution:check": [
            "@composer archive --format=zip --dir=build/distribution --file=dapter-preview",
            "@php scripts/check-composer-distribution.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArtisanToolbox\\Dapter\\DapterServiceProvider"
            ],
            "aliases": {
                "Dapter": "ArtisanToolbox\\Dapter\\Facades\\Dapter"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
