{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@artisan-toolbox/dapter",
  "version": "1.0.0-beta.4",
  "private": true,
  "description": "Data adapter foundations for Laravel and Inertia applications.",
  "keywords": [
    "artisan-toolbox",
    "dapter",
    "inertia",
    "laravel"
  ],
  "homepage": "https://atb.dev.br/packages/dapter/",
  "license": "MIT",
  "author": "Allan Mariucci Carvalho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artisan-toolbox/dapter.git"
  },
  "files": [
    "dist",
    "resources/js",
    "resources/contracts/read-v1.json",
    "LICENSE.md",
    "resources/contracts/updates-v1.json"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./resources/js/index.ts",
  "types": "./resources/js/index.ts",
  "imports": {
    "#dapter-native-action-types": {
      "node": "./resources/js/native-action-types-node.d.ts",
      "default": "./resources/js/native-action-types.d.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./resources/js/index.ts",
      "import": "./resources/js/index.ts"
    },
    "./package.json": "./package.json",
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/read-v1.json": "./resources/contracts/read-v1.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check && npm run typecheck",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test run",
    "test:types": "vp test run --typecheck.only",
    "check:dist": "node scripts/check-distribution.mjs",
    "release:build": "npm run check && npm test && npm run build && npm run build:consumer && npm run check:dist",
    "standards:check": "node .ai/sync.mjs --check",
    "build:consumer": "vp build --config tests/frontend/consumer/vite.config.ts",
    "native-types:generate": "node scripts/generate-native-action-types.mjs",
    "native-types:check": "node scripts/generate-native-action-types.mjs --check"
  },
  "devDependencies": {
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/vue3": "^3.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "laravel-echo": "^2.6.3",
    "typescript": "^5.8.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.14",
    "ziggy-js": "^2.6.5"
  },
  "peerDependencies": {
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/vue3": "^3.0.3",
    "vue": "^3.5.40",
    "ziggy-js": "^2.6.5"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.17.0"
}
